# =====================================================================
# RuralClass Environment Configuration
# =====================================================================

# 1. Google Gemini AI (Optional)
# If provided, powers live dynamic AI chat and personalized micro-plans.
# If omitted or empty, RuralClass operates 100% offline using built-in deterministic pedagogical rules.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model ID to use with Gemini API (Default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# 2. Server Configuration
PORT=3000
APP_URL="http://localhost:3000"

# 3. Persistence (SQLite Database)
# File path for SQLite database. Automatically migrated and seeded on initial run.
DB_PATH="./data/ruralclass.db"

# 4. Security & Access Control
# Optional teacher passcode. If set, prompts for passcode and stores signed session cookie.
# If left blank, server runs open for direct local evaluation.
TEACHER_PASSCODE=""

# 5. File Import Limits
# Maximum size in megabytes for timetable and mark sheet uploads (Excel, PDF, image)
MAX_UPLOAD_MB=10
